# Tracepaper Configuration
# Copy this file to .env and update values as needed

# LLM Configuration
LLM_PROVIDER=ollama              # Choose: "ollama" or "anthropic"
LLM_MODEL=qwen2.5:14b-instruct   # For 14B model; use qwen2.5:7b-instruct for smaller GPU
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=               # Only needed if LLM_PROVIDER=anthropic

# Embeddings Configuration
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Storage Configuration
DB_PATH=tracepaper.db
CACHE_DIR=.cache

# Logging Configuration
LOG_LEVEL=info                   # Choose: debug, info, warning, error, critical

# Feature Flags
CACHE_ENABLED=true               # Set to false to disable LLM response caching
